 /* ------------------------------------------------------------ */
 /*			 Procedures common to all secure sessions			*/
@@ -972,6 +974,10 @@
 	/* Disable old protocol versions */
 	SSL_CTX_set_options(SSL_context, SSL_OP_NO_SSLv2 | SSL_OP_NO_SSLv3);

+	/* Set SSL keylog callback if configured (for TLS traffic decryption) */
+	if (PQsslKeyLogCB)
