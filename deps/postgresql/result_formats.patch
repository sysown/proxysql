+
+/*
+ * PQsendQueryPreparedWithResultFormats
+ *		ProxySQL: like PQsendQueryPrepared, but sends an arbitrary array of
+ *		result-column format codes in the Bind message, as allowed by the
+ *		protocol (0 codes, 1 code for all columns, or one code per column).
+ *		PQsendQueryPrepared can only express a single code for all columns.
+ */
+int
+PQsendQueryPreparedWithResultFormats(PGconn *conn,
+									 const char *stmtName,
+									 int nParams,
+									 const char *const *paramValues,
+									 const int *paramLengths,
+									 const int *paramFormats,
+									 int nResultFormats,
+									 const int *resultFormats)
+{
+	if (!PQsendQueryStart(conn, true))
+		return 0;
+
+	/* check the arguments */
+	if (!stmtName)
+	{
+		libpq_append_conn_error(conn, "statement name is a null pointer");
+		return 0;
+	}
+	if (nParams < 0 || nParams > PQ_QUERY_PARAM_MAX_LIMIT)
+	{
+		libpq_append_conn_error(conn, "number of parameters must be between 0 and %d",
+								PQ_QUERY_PARAM_MAX_LIMIT);
+		return 0;
+	}
+	if (nResultFormats < 0 || nResultFormats > PQ_QUERY_PARAM_MAX_LIMIT ||
+		(nResultFormats > 0 && !resultFormats))
+	{
+		libpq_append_conn_error(conn, "number of result formats must be between 0 and %d",
+								PQ_QUERY_PARAM_MAX_LIMIT);
+		return 0;
+	}
+
+	return PQsendQueryGuts(conn,
+						   NULL,	/* no command to parse */
+						   stmtName,
+						   nParams,
+						   NULL,	/* no param types */
+						   paramValues,
+						   paramLengths,
+						   paramFormats,
+						   0,
+						   nResultFormats,
+						   resultFormats);
 }
 
