 	return tmpbuf;
 }
+
+/*
+ * PQgetResultFromPGconn
+ *       Get error result from PGconn
+ */
+const PGresult *
+PQgetResultFromPGconn(PGconn *conn)
+{
+       if (!conn)
+               return NULL;
+
+       if (conn->asyncStatus != PGASYNC_IDLE)
+               return NULL;
+
+       return conn->result;
+}
