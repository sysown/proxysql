+static int ma_decode_hex(char c)
+{
+  if (c >= '0' && c <= '9')
+    return c - '0';
+  if (c >= 'A' && c <= 'F')
+    return c - 'A' + 10;
+  if (c >= 'a' && c <= 'f')
+    return c - 'a' + 10;
+  return -1;
+}
+
+static my_bool ma_decode_proxy_password(const char *password, unsigned char *hash)
+{
+  size_t i;
+
+  if (password[0] != '*' || strlen(password) != 1 + 2 * MA_SHA1_HASH_SIZE)
+    return FALSE;
+
+  for (i= 0; i < MA_SHA1_HASH_SIZE; i++)
+  {
+    int high= ma_decode_hex(password[1 + 2 * i]);
+    int low= ma_decode_hex(password[2 + 2 * i]);
+    if (high < 0 || low < 0)
+      return FALSE;
+    hash[i]= (unsigned char)((high << 4) | low);
+  }
+  return TRUE;
+}
