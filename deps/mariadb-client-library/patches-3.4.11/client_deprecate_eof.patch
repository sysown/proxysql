+/* Read exactly the advertised column definitions; deprecated EOF omits
+   the metadata terminator. */
+MYSQL_FIELD *mthd_my_read_metadata_ex(MYSQL *mysql, MA_MEM_ROOT *alloc,
+                                      ulong field_count, uint metadata_fields)
+{
+  MYSQL_FIELD *fields;
+  ulong i;
+  ulong lengths[8];
+  char *row[9];
+
+  fields= (MYSQL_FIELD *)ma_alloc_root(alloc, sizeof(MYSQL_FIELD) * field_count);
+  if (!fields)
+  {
+    SET_CLIENT_ERROR(mysql, CR_OUT_OF_MEMORY, SQLSTATE_UNKNOWN, 0);
+    return NULL;
+  }
+  memset(fields, 0, sizeof(MYSQL_FIELD) * field_count);
+  for (i= 0; i < field_count; i++)
+  {
+    int rc= mthd_my_read_one_row(mysql, metadata_fields, row, lengths);
+    if (rc < 0)
+      return NULL;
+    if (rc > 0 || unpack_field(mysql, alloc, row, lengths, &fields[i]))
+    {
+      if (!mysql->net.last_errno)
+        SET_CLIENT_ERROR(mysql, CR_MALFORMED_PACKET, SQLSTATE_UNKNOWN, 0);
+      return NULL;
+    }
+  }
+  if (!(mysql->server_capabilities & CLIENT_DEPRECATE_EOF))
+  {
+    ulong len= ma_net_safe_read(mysql, NULL);
+    if (len == packet_error || ma_read_result_end(mysql, len))
+      return NULL;
+  }
+  return fields;
+}
