+/* Read a length-encoded integer only when all its bytes are in the packet. */
+static my_bool read_lenenc(uchar **pos, const uchar *end, ulonglong *value)
+{
+  size_t length;
+
+  if (*pos >= end || **pos == 255)
+    return TRUE;
+  length= **pos == 254 ? 9 : **pos == 253 ? 4 : **pos == 252 ? 3 : 1;
+  if ((size_t)(end - *pos) < length)
+    return TRUE;
+  *value= net_field_length_ll(pos);
+  return FALSE;
+}
+
+int ma_read_result_end(MYSQL *mysql, ulong length)
+{
+  const uchar *pos= mysql->net.read_pos;
+  unsigned int last_status= mysql->server_status;
+
+  if (mysql->server_capabilities & CLIENT_DEPRECATE_EOF)
+    return ma_read_ok_packet(mysql, mysql->net.read_pos + 1, length);
+  if (length == 1 && *pos == 254)
+    return 0;
+  if (length < 5 || *pos != 254)
+  {
+    SET_CLIENT_ERROR(mysql, CR_MALFORMED_PACKET, SQLSTATE_UNKNOWN, 0);
+    return 1;
+  }
+  mysql->warning_count= uint2korr(pos + 1);
+  mysql->server_status= uint2korr(pos + 3);
+  ma_status_callback(mysql, last_status);
+  return 0;
+}
