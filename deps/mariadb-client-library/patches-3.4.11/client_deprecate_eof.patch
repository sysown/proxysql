+static int test_reexecute_with_unread_results(MYSQL *mysql)
+{
+  const char *call= "CALL proxysql_eof_unread_results()";
+  const char *drop= "DROP PROCEDURE IF EXISTS proxysql_eof_unread_results";
+  MYSQL_STMT *stmt;
+  int rc, i;
+
+  FAIL_IF(!mysql, "could not establish test connection");
+  if (!(mysql->server_capabilities & CLIENT_DEPRECATE_EOF))
+    return SKIP;
+
+  rc= mysql_query(mysql, drop);
+  check_mysql_rc(rc, mysql);
+  rc= mysql_query(mysql, "CREATE PROCEDURE proxysql_eof_unread_results() "
+                         "BEGIN SELECT CAST(1 AS SIGNED); SELECT CAST(3 AS SIGNED); END");
+  check_mysql_rc(rc, mysql);
+
+  stmt= mysql_stmt_init(mysql);
+  FAIL_IF(!stmt, "could not allocate statement");
+  rc= mysql_stmt_prepare(stmt, SL(call));
+  check_stmt_rc(rc, stmt);
+  rc= mysql_stmt_execute(stmt);
+  check_stmt_rc(rc, stmt);
+
+  /* Re-executing must discard both pending result sets and the final OK. */
+  rc= mysql_stmt_execute(stmt);
+  check_stmt_rc(rc, stmt);
+  for (i= 0; i < 2; i++)
+  {
+    rc= mysql_stmt_store_result(stmt);
+    check_stmt_rc(rc, stmt);
+    FAIL_IF(mysql_stmt_num_rows(stmt) != 1, "expected one row from each result set");
+    rc= mysql_stmt_free_result(stmt);
+    check_stmt_rc(rc, stmt);
+    rc= mysql_stmt_next_result(stmt);
+    check_stmt_rc(rc, stmt);
+  }
+  FAIL_IF(mysql_stmt_field_count(stmt) != 0, "expected final OK packet");
+  FAIL_IF(mysql_stmt_close(stmt), "could not close statement");
+
+  rc= mysql_query(mysql, drop);
   check_mysql_rc(rc, mysql);
   return OK;
 }
