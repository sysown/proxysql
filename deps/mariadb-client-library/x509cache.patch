diff --git libmariadb/secure/proxysql_default_ca.h libmariadb/secure/proxysql_default_ca.h
new file mode 100644
index 00000000..4cb3bb94
--- /dev/null
+++ libmariadb/secure/proxysql_default_ca.h
@@ -0,0 +1,56 @@
+#ifndef PROXYSQL_DEFAULT_CA_H
+#define PROXYSQL_DEFAULT_CA_H
+
+#include <openssl/ssl.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static const char *const proxysql_default_ca_files[]= {
+  "/etc/ssl/certs/ca-certificates.crt",
+  "/etc/pki/tls/certs/ca-bundle.crt",
+  "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
+  "/etc/ssl/ca-bundle.pem",
+  "/var/lib/ca-certificates/ca-bundle.pem",
+  "/usr/local/share/certs/ca-root-nss.crt",
+  "/etc/ssl/cert.pem",
+  "/private/etc/ssl/cert.pem",
+  NULL
+};
+
+static int proxysql_ssl_is_readable_file(const char *path)
+{
+  struct stat status;
+
+  return path != NULL && stat(path, &status) == 0 &&
+         S_ISREG(status.st_mode) &&
+         (status.st_mode & (S_IWGRP | S_IWOTH)) == 0 &&
+         access(path, R_OK) == 0;
+}
+
+static int proxysql_ssl_load_verify_locations(
+    SSL_CTX *context,
+    const char *connector_ca_file,
+    const char *connector_ca_directory,
+    const char *const *default_ca_files)
+{
+  size_t index;
+
+  if (connector_ca_file != NULL || connector_ca_directory != NULL)
+    return SSL_CTX_load_verify_locations(context, connector_ca_file,
+                                         connector_ca_directory);
+
+  if (getenv("SSL_CERT_FILE") != NULL || getenv("SSL_CERT_DIR") != NULL)
+    return SSL_CTX_set_default_verify_paths(context);
+
+  for (index= 0; default_ca_files[index] != NULL; index++) {
+    if (!proxysql_ssl_is_readable_file(default_ca_files[index]))
+      continue;
+    return SSL_CTX_load_verify_locations(context, default_ca_files[index],
+                                         NULL);
+  }
+
+  return SSL_CTX_set_default_verify_paths(context);
+}
+
+#endif
diff --git libmariadb/secure/proxysql_ca_cache.h libmariadb/secure/proxysql_ca_cache.h
new file mode 100644
--- /dev/null
+++ libmariadb/secure/proxysql_ca_cache.h
@@ -0,0 +1,108 @@
+#ifndef PROXYSQL_CA_CACHE_H
+#define PROXYSQL_CA_CACHE_H
+
+#include <openssl/buffer.h>
+#include <openssl/pem.h>
+
+/* One immutable CA-file snapshot per thread. Holding a context owns the store;
+ * each SSL connection takes its own reference and survives cache replacement. */
+static __thread SSL_CTX *proxysql_ca_context;
+static __thread char *proxysql_ca_file;
+static __thread unsigned char proxysql_ca_digest[EVP_MAX_MD_SIZE];
+static __thread unsigned int proxysql_ca_digest_len;
+
+void proxysql_ssl_ca_cache_clear(void)
+{
+  SSL_CTX_free(proxysql_ca_context);
+  proxysql_ca_context= NULL;
+  free(proxysql_ca_file);
+  proxysql_ca_file= NULL;
+  proxysql_ca_digest_len= 0;
+}
+
+static int proxysql_ssl_load_cached_ca(SSL_CTX *ctx, const char *path)
+{
+  FILE *file= NULL;
+  BIO *snapshot= NULL;
+  BUF_MEM *contents= NULL;
+  STACK_OF(X509_INFO) *certificates= NULL;
+  SSL_CTX *replacement= NULL;
+  char *filename= NULL;
+  unsigned char digest[EVP_MAX_MD_SIZE];
+  unsigned int digest_len= 0;
+  char buffer[8192];
+  size_t count;
+  int i, loaded= 0, result= 0;
+
+  file= fopen(path, "rb");
+  snapshot= BIO_new(BIO_s_mem());
+  if (file == NULL || snapshot == NULL)
+    goto done;
+  while ((count= fread(buffer, 1, sizeof(buffer), file)) != 0) {
+    if (BIO_write(snapshot, buffer, (int)count) != (int)count)
+      goto done;
+  }
+  if (ferror(file))
+    goto done;
+  BIO_get_mem_ptr(snapshot, &contents);
+  if (contents == NULL || contents->length == 0 ||
+      EVP_Digest(contents->data, contents->length, digest, &digest_len,
+                 EVP_sha256(), NULL) != 1)
+    goto done;
+
+  if (proxysql_ca_context != NULL && proxysql_ca_file != NULL &&
+      strcmp(path, proxysql_ca_file) == 0 &&
+      digest_len == proxysql_ca_digest_len &&
+      memcmp(digest, proxysql_ca_digest, digest_len) == 0) {
+    SSL_CTX_set1_cert_store(ctx, SSL_CTX_get_cert_store(proxysql_ca_context));
+    result= 1;
+    goto done;
+  }
+
+  /* Parse the very bytes we hashed, not a second read of a changing file.
+   * Never publish metadata or mutate the old store until all loading succeeds. */
+  certificates= PEM_X509_INFO_read_bio(snapshot, NULL, NULL, NULL);
+  replacement= SSL_CTX_new(TLS_client_method());
+  filename= strdup(path);
+  if (certificates == NULL || replacement == NULL || filename == NULL)
+    goto done;
+  for (i= 0; i < sk_X509_INFO_num(certificates); ++i) {
+    X509_INFO *info= sk_X509_INFO_value(certificates, i);
+    X509_STORE *store= SSL_CTX_get_cert_store(replacement);
+    if (info->x509 != NULL) {
+      if (X509_STORE_add_cert(store, info->x509) != 1)
+        goto done;
+      ++loaded;
+    }
+    if (info->crl != NULL) {
+      if (X509_STORE_add_crl(store, info->crl) != 1)
+        goto done;
+      ++loaded;
+    }
+  }
+  if (loaded == 0)
+    goto done;
+
+  proxysql_ssl_ca_cache_clear();
+  proxysql_ca_context= replacement;
+  replacement= NULL;
+  proxysql_ca_file= filename;
+  filename= NULL;
+  memcpy(proxysql_ca_digest, digest, digest_len);
+  proxysql_ca_digest_len= digest_len;
+  SSL_CTX_set1_cert_store(ctx, SSL_CTX_get_cert_store(proxysql_ca_context));
+  result= 1;
+
+done:
+  if (file != NULL)
+    fclose(file);
+  BIO_free(snapshot);
+  sk_X509_INFO_pop_free(certificates, X509_INFO_free);
+  SSL_CTX_free(replacement);
+  free(filename);
+  if (!result)
+    proxysql_ssl_ca_cache_clear();
+  return result;
+}
+
+#endif
