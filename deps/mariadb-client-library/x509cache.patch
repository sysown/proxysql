diff --git libmariadb/secure/proxysql_default_ca.h libmariadb/secure/proxysql_default_ca.h
new file mode 100644
index 00000000..f2cb3eb0
--- /dev/null
+++ libmariadb/secure/proxysql_default_ca.h
@@ -0,0 +1,186 @@
+#ifndef PROXYSQL_DEFAULT_CA_H
+#define PROXYSQL_DEFAULT_CA_H
+
+#include <ctype.h>
+#include <dirent.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+typedef int (*proxysql_ssl_load_verify_locations_fn)(void *, const char *,
+                                                     const char *);
+typedef int (*proxysql_ssl_set_default_verify_paths_fn)(void *);
+typedef void (*proxysql_ssl_clear_error_fn)(void *);
+typedef int (*proxysql_ssl_error_mark_fn)(void *);
+
+struct proxysql_ssl_verify_ops {
+  void *context;
+  proxysql_ssl_load_verify_locations_fn load_verify_locations;
+  proxysql_ssl_set_default_verify_paths_fn set_default_verify_paths;
+  proxysql_ssl_error_mark_fn set_error_mark;
+  proxysql_ssl_error_mark_fn pop_error_to_mark;
+  proxysql_ssl_error_mark_fn clear_last_error_mark;
+  proxysql_ssl_clear_error_fn clear_error;
+};
+
+static const char *const proxysql_default_ca_files[]= {
+  "/etc/ssl/certs/ca-certificates.crt",
+  "/etc/pki/tls/certs/ca-bundle.crt",
+  "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
+  "/etc/ssl/ca-bundle.pem",
+  "/var/lib/ca-certificates/ca-bundle.pem",
+  "/usr/local/share/certs/ca-root-nss.crt",
+  "/etc/ssl/cert.pem",
+  "/private/etc/ssl/cert.pem",
+  "/opt/homebrew/etc/ca-certificates/cert.pem",
+  "/opt/homebrew/etc/openssl@3/cert.pem",
+  "/usr/local/etc/ca-certificates/cert.pem",
+  "/usr/local/etc/openssl@3/cert.pem",
+  NULL
+};
+
+static const char *const proxysql_default_ca_directories[]= {
+  "/etc/ssl/certs",
+  "/etc/pki/tls/certs",
+  "/etc/pki/ca-trust/extracted/openssl",
+  "/var/lib/ca-certificates/openssl",
+  "/usr/local/share/certs",
+  "/private/etc/ssl/certs",
+  "/opt/homebrew/etc/openssl@3/certs",
+  "/usr/local/etc/openssl@3/certs",
+  NULL
+};
+
+static int proxysql_ssl_is_readable_file(const char *path)
+{
+  struct stat status;
+
+  return path != NULL && stat(path, &status) == 0 && S_ISREG(status.st_mode) &&
+         access(path, R_OK) == 0;
+}
+
+static int proxysql_ssl_is_hash_name(const char *name)
+{
+  size_t index;
+
+  if (name == NULL || strlen(name) < 10)
+    return 0;
+  for (index= 0; index < 8; index++) {
+    if (!isxdigit((unsigned char)name[index]))
+      return 0;
+  }
+  if (name[8] != '.' || name[9] == '\0')
+    return 0;
+  for (index= 9; name[index] != '\0'; index++) {
+    if (!isdigit((unsigned char)name[index]))
+      return 0;
+  }
+  return 1;
+}
+
+static int proxysql_ssl_is_readable_hash_entry(const char *directory,
+                                               const char *name)
+{
+  size_t directory_length= strlen(directory);
+  size_t name_length= strlen(name);
+  char *entry_path;
+  int readable;
+
+  if (directory_length > (size_t)-1 - name_length - 2)
+    return 0;
+  entry_path= (char *)malloc(directory_length + name_length + 2);
+  if (entry_path == NULL)
+    return 0;
+  memcpy(entry_path, directory, directory_length);
+  entry_path[directory_length]= '/';
+  memcpy(entry_path + directory_length + 1, name, name_length + 1);
+  readable= proxysql_ssl_is_readable_file(entry_path);
+  free(entry_path);
+  return readable;
+}
+
+static int proxysql_ssl_is_usable_hash_directory(const char *path)
+{
+  DIR *directory;
+  struct dirent *entry;
+  struct stat status;
+  int usable= 0;
+
+  if (path == NULL || stat(path, &status) != 0 || !S_ISDIR(status.st_mode) ||
+      access(path, R_OK | X_OK) != 0)
+    return 0;
+
+  directory= opendir(path);
+  if (directory == NULL)
+    return 0;
+  while ((entry= readdir(directory)) != NULL) {
+    if (proxysql_ssl_is_hash_name(entry->d_name) &&
+        proxysql_ssl_is_readable_hash_entry(path, entry->d_name)) {
+      usable= 1;
+      break;
+    }
+  }
+  closedir(directory);
+  return usable;
+}
+
+static void proxysql_ssl_finish_probe(
+    const struct proxysql_ssl_verify_ops *ops,
+    int marked,
+    int succeeded)
+{
+  if (marked) {
+    if (succeeded)
+      ops->clear_last_error_mark(ops->context);
+    else
+      ops->pop_error_to_mark(ops->context);
+  } else if (!succeeded) {
+    ops->clear_error(ops->context);
+  }
+}
+
+static int proxysql_ssl_load_verify_locations(
+    const char *connector_ca_file,
+    const char *connector_ca_directory,
+    const char *const *default_ca_files,
+    const char *const *default_ca_directories,
+    const struct proxysql_ssl_verify_ops *ops)
+{
+  size_t index;
+  int marked;
+
+  if (connector_ca_file != NULL || connector_ca_directory != NULL)
+    return ops->load_verify_locations(ops->context, connector_ca_file,
+                                      connector_ca_directory);
+
+  if (getenv("SSL_CERT_FILE") != NULL || getenv("SSL_CERT_DIR") != NULL)
+    return ops->set_default_verify_paths(ops->context);
+
+  for (index= 0; default_ca_files[index] != NULL; index++) {
+    if (!proxysql_ssl_is_readable_file(default_ca_files[index]))
+      continue;
+    marked= ops->set_error_mark(ops->context);
+    if (ops->load_verify_locations(ops->context, default_ca_files[index], NULL)) {
+      proxysql_ssl_finish_probe(ops, marked, 1);
+      return 1;
+    }
+    proxysql_ssl_finish_probe(ops, marked, 0);
+  }
+
+  for (index= 0; default_ca_directories[index] != NULL; index++) {
+    if (!proxysql_ssl_is_usable_hash_directory(default_ca_directories[index]))
+      continue;
+    marked= ops->set_error_mark(ops->context);
+    if (ops->load_verify_locations(ops->context, NULL,
+                                   default_ca_directories[index])) {
+      proxysql_ssl_finish_probe(ops, marked, 1);
+      return 1;
+    }
+    proxysql_ssl_finish_probe(ops, marked, 0);
+  }
+
+  return ops->set_default_verify_paths(ops->context);
+}
+
+#endif
