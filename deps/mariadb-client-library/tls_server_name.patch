+const char *ma_tls_get_server_name(MYSQL *mysql)
+{
+  if (mysql->options.extension && mysql->options.extension->tls_server_name &&
+      mysql->options.extension->tls_server_name[0])
+    return mysql->options.extension->tls_server_name;
+  return mysql->host;
+}
