+/**
+ * Validate the client certificate of the real GnuTLS session. libmicrohttpd
+ * only *requests* a client certificate when a trust PEM is configured; it
+ * never verifies the presented chain. This check runs in the request path
+ * before any resource lookup, so every handler (including /sync and
+ * /metrics) is behind the same gate.
+ *
+ * gnutls_certificate_verify_peers() verifies the peer chain against the
+ * session trust store (issuer/trust, validity period, signature) and, through
+ * GNUTLS_DT_KEY_PURPOSE_OID, the TLS client-authentication purpose. A return
+ * value >= 0 is NOT sufficient: status must also be zero.
+ */
+static bool client_certificate_is_valid(MHD_Connection* connection)
+{
+    const MHD_ConnectionInfo* info = MHD_get_connection_info(
+        connection, MHD_CONNECTION_INFO_GNUTLS_SESSION);
+    if (info == nullptr || info->tls_session == nullptr)
+        return false;
+
+    gnutls_session_t session =
+        static_cast<gnutls_session_t>(info->tls_session);
+    if (gnutls_certificate_type_get(session) != GNUTLS_CRT_X509)
+        return false;
+
+    unsigned int peers_size = 0;
+    const gnutls_datum_t* peers =
+        gnutls_certificate_get_peers(session, &peers_size);
+    if (peers == nullptr || peers_size == 0)
+        return false;
+
+    gnutls_typed_vdata_st vdata {};
+    vdata.type = GNUTLS_DT_KEY_PURPOSE_OID;
+    vdata.data = reinterpret_cast<unsigned char*>(
+        const_cast<char*>(GNUTLS_KP_TLS_WWW_CLIENT));
+    vdata.size = 0;
+
+    unsigned int status = 0;
+    const int rc = gnutls_certificate_verify_peers(
+        session, &vdata, 1, &status);
+    return rc >= 0 && status == 0;
+}
