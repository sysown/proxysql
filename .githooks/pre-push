#!/usr/bin/env bash

set -euo pipefail

if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
	echo "pre-push lint: unable to determine the Git worktree root" >&2
	exit 1
fi

runner="${repo_root}/test/infra/control/run-ci-lint.bash"
if [[ ! -x "${runner}" ]]; then
	echo "pre-push lint: missing executable runner: ${runner}" >&2
	exit 1
fi

# Git exports repository-local variables such as GIT_DIR to hooks (always
# when pushing from a linked worktree). The lint suite builds throwaway fixture
# repositories with plain `git` commands; with GIT_DIR inherited those commands
# would commit, rewrite refs and set core.bare in THIS repository instead.
while IFS= read -r variable_name; do
	unset "${variable_name}"
done < <(git rev-parse --local-env-vars)

echo ">>> Running repository CI lint suite before push"
cd "${repo_root}"
exec "${runner}"
