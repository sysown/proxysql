MYSQL_VERSION=8.4

PREFIX=14

WHG=${PREFIX}00
RHG=${PREFIX}01
BHG=${PREFIX}02
OHG=${PREFIX}03

export BINLOG_WHG=${WHG}
export BINLOG_RHG=${RHG}

MYSQL1_PORT=${PREFIX}306
MYSQL2_PORT=${PREFIX}307
MYSQL3_PORT=${PREFIX}308

BINLOG1_PORT=${PREFIX}021
BINLOG2_PORT=${PREFIX}022
BINLOG3_PORT=${PREFIX}023

ORC1_PORT=${PREFIX}101
ORC2_PORT=${PREFIX}102
ORC3_PORT=${PREFIX}103

INFRA=${INFRA:-infra-mysql84-binlog}

# Export hostgroup for TAP tests that need it
export TAP_REG_TEST_3549_AUTOCOMMIT_TRACKING___MYSQL_SERVER_HOSTGROUP=${WHG}
export TAP_MYSQL8_BACKEND_HG=${WHG}
