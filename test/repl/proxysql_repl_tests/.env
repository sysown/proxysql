MYSQL_VERSION=${MYSQL_VERSION:-5.7}

# hostgroups variables
PREFIX=
WHG=${PREFIX}00
RHG=${PREFIX}01
RHG1=${PREFIX}02
RHG2=${PREFIX}03

INFRA=${INFRA:-proxysql_repl_tests}
INFRA_LOGS_PATH=${INFRA_LOGS_PATH:-./logs}

MYSQL1_HOST="mysql1."
MYSQL2_HOST="mysql2."
MYSQL3_HOST="mysql3."
MYSQL4_HOST="mysql4."
MYSQL5_HOST="mysql5."

MYSQL1_PORT=3306
MYSQL2_PORT=3306
MYSQL3_PORT=3306
MYSQL4_PORT=3306
MYSQL5_PORT=3306

SSL=${SSL:-no-ssl}
# proxysql backend SSL
USE_SSL=${USE_SSL:-0}
# proxysql frontend SSL
HAVE_SSL=${HAVE_SSL:-false}
# mysql user enforce SSL
REQUIRE_SSL=${REQUIRE_SSL:-}

# enable Debezium
DEBEZIUM=${DEBEZIUM:-}
