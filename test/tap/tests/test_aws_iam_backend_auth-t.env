# Reserved for the SDK-on daemon variant on a host with AWS SDK for C++.
# The always-runnable controlled component test does not read these values.
AWS_ACCESS_KEY_ID=TAPONLYACCESSKEY
AWS_SECRET_ACCESS_KEY=tap-only-secret-never-use
AWS_SESSION_TOKEN=tap-only-session-never-use
AWS_EC2_METADATA_DISABLED=true
TAP_QUIET_ENVLOAD=1
