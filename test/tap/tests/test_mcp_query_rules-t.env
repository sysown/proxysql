# MCP Query Rules Test Environment Variables

# suppress env load messages
TAP_QUIET_ENVLOAD=1

# ProxySQL Admin credentials
TAP_ADMINUSERNAME=radmin
TAP_ADMINPASSWORD=radmin
TAP_ADMINHOST=127.0.0.1
TAP_ADMINPORT=6032

# MySQL Backend configuration
# NOTE: Update TAP_MYSQLPASSWORD to match your MySQL root password
# If your MySQL root has no password, use the word "none" (without quotes)
TAP_MYSQLHOST=127.0.0.1
TAP_MYSQLPORT=3306
TAP_MYSQLUSERNAME=root
TAP_MYSQLPASSWORD=root

# MCP Server configuration
TAP_MCPPORT=6071

# MySQL database for testing
TEST_DB_NAME=testdb

# MySQL database name (used by MCP and test scripts)
MYSQL_DATABASE=testdb
