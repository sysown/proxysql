# Per-group ProxySQL config for the mysqlx-soak/mysqlx-e2e TAP group.
# Identical to test/infra/control/proxysql-ci.cnf except for the
# `plugins=("...")` line that asks the chassis to load the mysqlx
# plugin at Phase A. The plugin .so is bind-mounted into the
# ProxySQL container at /usr/lib/proxysql/ProxySQL_MySQLX_Plugin.so by
# start-proxysql-isolated.bash when PROXYSQL_LOAD_MYSQLX_PLUGIN=1.

admin_variables=
{
    admin_credentials="admin:admin;radmin:radmin"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    threads=4
    max_connections=2048
    interfaces="0.0.0.0:6033"
    monitor_username="monitor"
    monitor_password="monitor"
}

pgsql_variables=
{
    interfaces="0.0.0.0:6133"
}

sqliteserver_variables=
{
    mysql_ifaces="0.0.0.0:6030"
}

plugins=(
    "/usr/lib/proxysql/ProxySQL_MySQLX_Plugin.so"
)
