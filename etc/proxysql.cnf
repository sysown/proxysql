#############################################################################
# The sections below also round-trip through the configuration file, i.e.
# they are emitted by SAVE CONFIG TO FILE / SELECT CONFIG INTO OUTFILE and
# consumed by LOAD MYSQL|PGSQL QUERY RULES FROM CONFIG, LOAD MYSQL|PGSQL
# FIREWALL FROM CONFIG, and LOAD MYSQL|PGSQL SERVERS FROM CONFIG (issue #3468).
# They are shown here commented out; in normal operation they are managed via
# the admin interface and persisted with SAVE ... TO DISK. Each pgsql_* variant
# mirrors its mysql_* sibling (a PostgreSQL section keys on `database` where the
# MySQL one keys on `schemaname`).
#############################################################################

# Fast-routing query rules: constant-time (username, schema) -> hostgroup routing.
mysql_query_rules_fast_routing:
(
#	{
#		username="app1"
#		schemaname="shard1"
#		flagIN=0
#		destination_hostgroup=10
#		comment=""
#	}
)

